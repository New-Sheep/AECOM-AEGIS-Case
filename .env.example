# AEGIS — copy to .env (do not commit .env)
# Sprint 1 does not require an LLM key.

# Django
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
AEGIS_API_BASE=http://127.0.0.1:8000

# NVIDIA NIM (optional live briefs). Get a key at https://build.nvidia.com
# Command Center defaults to fast standard briefs (?mode=fake). Use sidebar
# "Live AI brief" or FAKE_LLM=0 + mode=live when you want NIM.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
FAKE_LLM=1
# L4 HITL stub token (not a secret — demo only)
# AEGIS-EXEC-DEMO
